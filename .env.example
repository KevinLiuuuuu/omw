# Copy to .env and fill in. .env is git-ignored.

# OpenRouteService key, used by /api/route for directions.
ORS_API_KEY=

# Google Gemini API key, used by /api/estimate to guess shelf fullness from a
# photo. Optional: without it the "Use a photo" button silently does nothing and
# the manual sliders work as before.
GEMINI_API_KEY=
